# Clerk Authentication
CLERK_SECRET_KEY=sk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLERK_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Supabase
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# AI Providers (set AI_PROVIDER to "groq" or "gemini")
AI_PROVIDER=groq
GROQ_API_KEY=gsk_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
GEMINI_API_KEY=AIzaSy_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Blockchain
SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key
CONTRACT_ADDRESS=0xYourDeployedContractAddress
# Relayer wallet — address must be passed to TaskStakerV2 constructor at deploy time
# Generate: node -e "const {ethers}=require('ethers');const w=ethers.Wallet.createRandom();console.log('Address:',w.address,'\nKey:',w.privateKey)"
RELAYER_ADDRESS=0xYourRelayerWalletAddress
RELAYER_PRIVATE_KEY=0xYourRelayerPrivateKey

# Email — optional, uses Resend (https://resend.com free tier)
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=TaskStaker <noreply@yourdomain.com>

# Embedded wallets — all user wallets derived from this + their clerk_id
# TREAT LIKE A MASTER PRIVATE KEY. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
WALLET_MASTER_SECRET=change-this-to-a-long-random-secret

# Optional: additional chain RPCs for balance display (public RPCs used as fallback)
BASE_RPC_URL=https://mainnet.base.org
POLYGON_RPC_URL=https://polygon-rpc.com

# Server
PORT=3001
FRONTEND_URL=http://localhost:5173
