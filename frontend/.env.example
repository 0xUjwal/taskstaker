# Copy this to .env and fill in your values

# Contract address from deployment
VITE_CONTRACT_ADDRESS=0xYourDeployedContractAddress

# Web3.Storage API token (get from https://web3.storage)
VITE_WEB3STORAGE_TOKEN=your_web3_storage_api_token_here

# Sepolia RPC endpoints used when adding/switching network in wallet
VITE_SEPOLIA_RPC_URL=https://eth-sepolia.g.alchemy.com/v2/your-api-key
VITE_SEPOLIA_FALLBACK_RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
